<% layout("/layouts/boilerplate") %>

<div class="d-flex align-items-center justify-content-between mb-4">
  <div>
    <h2 class="fw-bold text-white mb-1"><i class="fa-solid fa-ticket text-danger me-2"></i>Your Bookings & Tickets</h2>
    <p class="text-muted small mb-0">View, download or manage your cinema tickets</p>
  </div>
  <a href="/movies" class="btn btn-bms-outline btn-sm">
    <i class="fa-solid fa-plus me-1"></i>Book More Movies
  </a>
</div>

<% if (bookings && bookings.length > 0) { %>
  <div class="row row-cols-1 g-4">
    <% bookings.forEach(b => { %>
      <div class="col">
        <div class="p-4 rounded-4" style="background: #141722; border: 1px solid rgba(255,255,255,0.08);">
          <div class="row align-items-center g-3">
            <!-- Movie Thumbnail -->
            <div class="col-auto">
              <img src="<%= b.movie?.poster?.url || 'https://images.unsplash.com/photo-1536440136628-849c177e76a1' %>" 
                   alt="<%= b.movie?.title %>" 
                   class="rounded-3 shadow" 
                   style="width: 70px; height: 100px; object-fit: cover;">
            </div>

            <!-- Ticket Details -->
            <div class="col-md-5">
              <div class="d-flex align-items-center gap-2 mb-1">
                <h5 class="fw-bold text-white mb-0"><%= b.movie ? b.movie.title : 'Movie' %></h5>
                <span class="badge bg-secondary" style="font-size: 0.7rem;"><%= b.format %></span>
              </div>
              <div class="text-muted small mb-1">
                <strong><%= b.theatre ? b.theatre.name : 'Cinema' %></strong> • <%= b.show ? b.show.screen : 'Audi 1' %>
              </div>
              <div class="text-white small">
                <i class="fa-regular fa-calendar text-danger me-1"></i>
                <%= new Date(b.showDate).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }) %> at <%= b.showTime %>
              </div>
            </div>

            <!-- Seat & Price Info -->
            <div class="col-md-3">
              <span class="text-muted small d-block">Seats (<%= b.seatCategory %>):</span>
              <div class="d-flex gap-1 flex-wrap mb-2">
                <% b.seats.forEach(s => { %>
                  <span class="badge bg-danger"><%= s %></span>
                <% }); %>
              </div>
              <span class="text-success fw-bold fs-6">₹<%= b.grandTotal.toLocaleString("en-IN") %></span>
              <span class="badge <%= b.paymentStatus === 'paid' ? 'bg-success' : 'bg-danger' %> ms-2" style="font-size: 0.72rem;">
                <%= b.paymentStatus.toUpperCase() %>
              </span>
            </div>

            <!-- Actions -->
            <div class="col-md-2 text-md-end">
              <div class="d-flex flex-column gap-2">
                <a href="/bookings/ticket/<%= b._id %>" class="btn btn-bms btn-sm w-100">
                  <i class="fa-solid fa-eye me-1"></i>View Ticket
                </a>
                <% if (b.paymentStatus === 'paid') { %>
                  <form action="/bookings/<%= b._id %>/cancel" method="POST" onsubmit="return confirm('Cancel this booking?');">
                    <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                      Cancel
                    </button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% }); %>
  </div>
<% } else { %>
  <div class="text-center py-5 my-5 rounded-4 p-5" style="background: #141722; border: 1px dashed rgba(255,255,255,0.1);">
    <i class="fa-solid fa-ticket-simple text-muted fs-1 mb-3"></i>
    <h4 class="text-white">No Tickets Booked Yet</h4>
    <p class="text-muted">You haven't booked any movie tickets yet. Pick an exciting movie to get started!</p>
    <a href="/movies" class="btn btn-bms mt-2">Explore Movies Now</a>
  </div>
<% } %>
