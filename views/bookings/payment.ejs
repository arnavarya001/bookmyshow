<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center my-4">
  <div class="col-lg-8">
    <div class="card bg-dark border-secondary rounded-4 shadow-lg overflow-hidden">
      <!-- Payment Header -->
      <div class="p-4" style="background: linear-gradient(135deg, #1C202B, #151821); border-bottom: 1px solid rgba(255,255,255,0.08);">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <h3 class="fw-bold text-white mb-1"><i class="fa-solid fa-lock text-success me-2"></i>Order Summary</h3>
            <span class="text-muted small">Secure 256-Bit SSL Checkout</span>
          </div>
          <span class="badge bg-danger px-3 py-2 fs-6">Order #<%= orderId %></span>
        </div>
      </div>

      <div class="card-body p-4 p-md-5">
        <!-- Movie & Cinema Snapshot -->
        <div class="d-flex gap-4 align-items-center pb-4 mb-4 border-bottom border-secondary">
          <img src="<%= show.movie.poster.url %>" alt="<%= show.movie.title %>" class="rounded-3 shadow" style="width: 80px; height: 120px; object-fit: cover;">
          <div class="flex-grow-1">
            <h4 class="fw-bold text-white mb-1"><%= show.movie.title %></h4>
            <div class="text-muted mb-2"><%= show.movie.language.join(", ") %> • <%= show.format %></div>
            <div class="text-light small">
              <strong><%= show.theatre.name %></strong> (<%= show.screen %>)<br>
              <i class="fa-regular fa-calendar text-danger me-1"></i> <%= new Date(show.showDate).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }) %> at <%= show.showTime %>
            </div>
          </div>
        </div>

        <!-- Seats & Cost Breakdown -->
        <div class="mb-4">
          <h5 class="fw-bold text-white mb-3">Booking Details</h5>
          <div class="d-flex justify-content-between py-2 border-bottom border-dark text-muted">
            <span>Seats (<%= seatCategory %>: <%= seats.join(", ") %>)</span>
            <span class="text-white fw-bold">₹<%= ticketAmount.toLocaleString("en-IN") %></span>
          </div>

          <% if (snacks && snacks.length > 0) { %>
            <div class="py-2 border-bottom border-dark">
              <span class="text-muted d-block mb-1">Concessions & Snacks:</span>
              <% snacks.forEach(s => { %>
                <div class="d-flex justify-content-between text-muted small ps-3">
                  <span><%= s.name %> (x<%= s.quantity %>)</span>
                  <span>₹<%= (s.price * s.quantity).toLocaleString("en-IN") %></span>
                </div>
              <% }); %>
            </div>
          <% } %>

          <div class="d-flex justify-content-between py-2 border-bottom border-dark text-muted">
            <span>Integrated GST & Convenience Fee</span>
            <span class="text-white">₹<%= convenienceFee.toLocaleString("en-IN") %></span>
          </div>

          <div class="d-flex justify-content-between py-3 fs-4 fw-bold text-white">
            <span>Amount Payable</span>
            <span class="text-danger">₹<%= grandTotal.toLocaleString("en-IN") %></span>
          </div>
        </div>

        <!-- Payment Actions Form -->
        <form id="paymentConfirmForm" action="/bookings/verify-payment" method="POST">
          <input type="hidden" name="razorpay_order_id" id="rzp_order_id" value="<%= orderId %>">
          <input type="hidden" name="razorpay_payment_id" id="rzp_payment_id" value="">
          <input type="hidden" name="razorpay_signature" id="rzp_signature" value="">
          <input type="hidden" name="test_mode" id="test_mode" value="false">

          <div class="d-flex flex-column gap-3 mt-4">
            <!-- 1. Instant Test / Sandbox Checkout Button -->
            <button type="button" class="btn btn-success btn-lg py-3 fw-bold shadow d-flex align-items-center justify-content-center gap-2" id="instantPayBtn">
              <i class="fa-solid fa-bolt"></i> Pay ₹<%= grandTotal.toLocaleString("en-IN") %> (Instant Demo Payment)
            </button>

            <% if (razorpayKey && razorpayKey !== "rzp_test_mock_key") { %>
              <!-- 2. Official Razorpay Gateway Button -->
              <button type="button" class="btn btn-bms btn-lg py-3 fw-bold shadow d-flex align-items-center justify-content-center gap-2" id="razorpayLiveBtn">
                <i class="fa-solid fa-credit-card"></i> Pay via Razorpay Gateway
              </button>
            <% } %>

            <a href="/shows/<%= show._id %>/seats" class="btn btn-bms-dark py-2 text-center">
              <i class="fa-solid fa-arrow-left me-1"></i>Back to Seat Selection
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Razorpay Script -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  const instantPayBtn = document.getElementById("instantPayBtn");
  const razorpayLiveBtn = document.getElementById("razorpayLiveBtn");
  const form = document.getElementById("paymentConfirmForm");

  // Instant Demo Payment
  if (instantPayBtn) {
    instantPayBtn.addEventListener("click", () => {
      document.getElementById("test_mode").value = "true";
      document.getElementById("rzp_payment_id").value = "pay_test_" + Date.now();
      document.getElementById("rzp_signature").value = "test_sig_verified";
      form.submit();
    });
  }

  // Live Razorpay Checkout
  if (razorpayLiveBtn) {
    razorpayLiveBtn.addEventListener("click", () => {
      const options = {
        key: "<%= razorpayKey %>",
        amount: "<%= grandTotal * 100 %>",
        currency: "INR",
        name: "BookMyShow",
        description: "Cinema Tickets: <%= show.movie.title %>",
        image: "<%= show.movie.poster.url %>",
        order_id: "<%= orderId %>",
        handler: function(response) {
          document.getElementById("rzp_payment_id").value = response.razorpay_payment_id;
          document.getElementById("rzp_order_id").value = response.razorpay_order_id;
          document.getElementById("rzp_signature").value = response.razorpay_signature;
          form.submit();
        },
        prefill: {
          name: "<%= currUser ? currUser.username : '' %>",
          email: "<%= currUser ? currUser.email : '' %>",
          contact: "<%= currUser && currUser.phone ? currUser.phone : '' %>"
        },
        theme: {
          color: "#F84464"
        }
      };

      const rzp = new Razorpay(options);
      rzp.open();
    });
  }
</script>
