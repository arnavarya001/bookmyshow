<% layout("layouts/boilerplate") %>

<div class="row justify-content-center my-4">
  <div class="col-lg-7">
    <!-- Success Banner -->
    <div class="text-center mb-4">
      <% if (booking.paymentStatus === 'paid') { %>
        <div class="d-inline-flex align-items-center justify-content-center bg-success text-white rounded-circle mb-2" style="width: 50px; height: 50px;">
          <i class="fa-solid fa-check fs-4"></i>
        </div>
        <h3 class="fw-bold text-white mb-1">Booking Confirmed!</h3>
        <p class="text-muted small">Your m-ticket has been generated. Please display this at the cinema entrance.</p>
      <% } else { %>
        <div class="d-inline-flex align-items-center justify-content-center bg-danger text-white rounded-circle mb-2" style="width: 50px; height: 50px;">
          <i class="fa-solid fa-ban fs-4"></i>
        </div>
        <h3 class="fw-bold text-white mb-1">Booking Cancelled</h3>
        <p class="text-muted small">This booking has been cancelled.</p>
      <% } %>
    </div>

    <!-- Digital Ticket Card -->
    <div class="digital-ticket-container" id="printableTicket">
      <!-- Header -->
      <div class="ticket-header d-flex align-items-center justify-content-between">
        <div>
          <span class="badge bg-black bg-opacity-25 text-white mb-1 px-3 py-1 text-uppercase" style="letter-spacing: 1px;">M-TICKET</span>
          <h3 class="fw-bold mb-0 text-white"><%= booking.movie.title %></h3>
          <small class="text-white-50"><%= booking.movie.language.join(", ") %> • <%= booking.format %></small>
        </div>
        <div class="text-end">
          <span class="d-block small text-white-50">Booking ID</span>
          <span class="fs-5 fw-bold font-monospace"><%= booking.bookingId %></span>
        </div>
      </div>

      <!-- Ticket Body -->
      <div class="ticket-body">
        <div class="row g-4 mb-3">
          <div class="col-6">
            <small class="text-muted text-uppercase d-block">Cinema Hall</small>
            <strong class="text-white fs-6"><%= booking.theatre.name %></strong>
            <div class="text-muted small"><%= booking.theatre.city %></div>
          </div>
          <div class="col-6 text-end">
            <small class="text-muted text-uppercase d-block">Auditorium Screen</small>
            <strong class="text-white fs-6"><%= booking.show.screen %></strong>
          </div>

          <div class="col-6">
            <small class="text-muted text-uppercase d-block">Date & Time</small>
            <strong class="text-white fs-6">
              <%= new Date(booking.showDate).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }) %>
            </strong>
            <div class="text-danger fw-bold"><%= booking.showTime %></div>
          </div>

          <div class="col-6 text-end">
            <small class="text-muted text-uppercase d-block">Seats (<%= booking.seatCategory %>)</small>
            <div class="d-flex justify-content-end gap-1 flex-wrap mt-1">
              <% booking.seats.forEach(seat => { %>
                <span class="badge bg-danger fs-6 px-2 py-1"><%= seat %></span>
              <% }); %>
            </div>
          </div>
        </div>

        <!-- Snacks Summary if applicable -->
        <% if (booking.snacks && booking.snacks.length > 0) { %>
          <div class="p-3 rounded-3 mb-3" style="background: #1F2432; border: 1px solid rgba(255,255,255,0.06);">
            <div class="d-flex align-items-center gap-2 mb-1">
              <i class="fa-solid fa-utensils text-warning"></i>
              <strong class="text-white small">Food & Beverage Add-on</strong>
            </div>
            <% booking.snacks.forEach(s => { %>
              <div class="d-flex justify-content-between text-muted small">
                <span><%= s.name %> (x<%= s.quantity %>)</span>
                <span>₹<%= s.price * s.quantity %></span>
              </div>
            <% }); %>
          </div>
        <% } %>

        <!-- Perforated Tear Line -->
        <div class="ticket-divider">
          <div class="ticket-dashed-line"></div>
        </div>

        <!-- QR Code & Barcode Verification -->
        <div class="row align-items-center py-2">
          <div class="col-sm-7">
            <div class="d-flex flex-column gap-1">
              <small class="text-muted">Total Amount Paid</small>
              <h4 class="text-success fw-bold mb-0">₹<%= booking.grandTotal.toLocaleString("en-IN") %></h4>
              <small class="text-white-50" style="font-size: 0.75rem;">Payment ID: <%= booking.paymentId %></small>
              <span class="badge <%= booking.paymentStatus === 'paid' ? 'bg-success' : 'bg-danger' %> w-auto d-inline-block mt-2 align-self-start">
                Status: <%= booking.paymentStatus.toUpperCase() %>
              </span>
            </div>
          </div>
          <div class="col-sm-5 text-center mt-3 mt-sm-0">
            <!-- Simulated QR Code -->
            <div class="d-inline-block p-2 bg-white rounded-3 shadow">
              <img src="https://api.qrserver.com/v1/create-qr-code/?size=110x110&data=<%= encodeURIComponent(booking.qrCode || booking.bookingId) %>" 
                   alt="Ticket QR Code" 
                   style="width: 100px; height: 100px; display: block;">
            </div>
            <small class="text-muted d-block mt-1 font-monospace" style="font-size: 0.7rem;">Scan at Audi Entry</small>
          </div>
        </div>
      </div>
    </div>

    <!-- Actions -->
    <div class="d-flex align-items-center justify-content-center gap-3 mt-4 flex-wrap">
      <button onclick="window.print()" class="btn btn-bms-dark px-4 py-2">
        <i class="fa-solid fa-print me-2"></i>Print Ticket
      </button>
      <a href="/bookings/history" class="btn btn-bms px-4 py-2">
        <i class="fa-solid fa-ticket me-2"></i>View All Bookings
      </a>

      <% if (booking.paymentStatus === 'paid') { %>
        <form action="/bookings/<%= booking._id %>/cancel" method="POST" onsubmit="return confirm('Are you sure you want to cancel this booking? Refund will be initiated to original payment source.');">
          <button type="submit" class="btn btn-outline-danger px-4 py-2">
            <i class="fa-solid fa-xmark me-1"></i>Cancel Ticket
          </button>
        </form>
      <% } %>
    </div>
  </div>
</div>
