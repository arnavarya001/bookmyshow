<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center my-5 py-5 text-center">
  <div class="col-md-6">
    <div class="mb-4 text-danger" style="font-size: 4rem;">
      <i class="fa-solid fa-triangle-exclamation"></i>
    </div>
    <h2 class="fw-bold text-white mb-3">Oops! Something went wrong</h2>
    <p class="text-muted fs-5 mb-4"><%= message %></p>
    <a href="/movies" class="btn btn-bms px-4 py-2">
      <i class="fa-solid fa-house me-2"></i>Back to Movies
    </a>
  </div>
</div>