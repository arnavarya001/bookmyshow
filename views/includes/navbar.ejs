<header class="bms-navbar">
  <div class="container d-flex align-items-center justify-content-between">
    <!-- Brand Logo -->
    <a href="/movies" class="bms-brand">
      <div class="bms-brand-icon">
        <i class="fa-solid fa-film"></i>
      </div>
      <div>book<span>my</span>show</div>
    </a>

    <!-- Live Search Input -->
    <div class="bms-search-container d-none d-md-block">
      <form action="/movies/search" method="GET" class="position-relative">
        <i class="fa-solid fa-magnifying-glass bms-search-icon"></i>
        <input 
          type="text" 
          name="q" 
          id="bmsSearchInput" 
          class="bms-search-input" 
          placeholder="Search for Movies, Events, Plays & Cinemas..." 
          autocomplete="off"
        >
        <!-- Dynamic Autocomplete Results -->
        <div id="bmsSuggestionDropdown" class="bms-autocomplete-dropdown"></div>
      </form>
    </div>

    <!-- Right Controls -->
    <div class="d-flex align-items-center gap-3">
      <!-- City Selection Pill -->
      <div class="bms-city-pill" id="citySelectorPill" title="Change Location">
        <i class="fa-solid fa-location-dot text-danger"></i>
        <span><%= typeof selectedCity !== 'undefined' ? selectedCity : 'Mumbai' %></span>
        <i class="fa-solid fa-chevron-down small text-muted"></i>
      </div>

      <!-- User Auth State -->
      <% if (!currUser) { %>
        <a href="/login" class="btn btn-bms-outline btn-sm">Sign In</a>
        <a href="/signup" class="btn btn-bms btn-sm d-none d-sm-inline-flex">Sign Up</a>
      <% } else { %>
        <div class="dropdown">
          <button class="btn btn-bms-dark btn-sm dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <img src="<%= currUser.avatar || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=80&q=80' %>" 
                 alt="Avatar" 
                 class="rounded-circle" 
                 style="width: 24px; height: 24px; object-fit: cover;">
            <span><%= currUser.username %></span>
            <% if (currUser.role === 'admin') { %>
              <span class="badge bg-danger rounded-pill" style="font-size: 0.65rem;">ADMIN</span>
            <% } %>
          </button>
          <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark" style="background: #181C26; border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 0.5rem;">
            <li>
              <a class="dropdown-item py-2 d-flex align-items-center gap-2 rounded-2" href="/bookings/history">
                <i class="fa-solid fa-ticket text-danger"></i> Your Tickets
              </a>
            </li>
            <li>
              <a class="dropdown-item py-2 d-flex align-items-center gap-2 rounded-2" href="/watchlist">
                <i class="fa-solid fa-heart text-danger"></i> Watchlist
              </a>
            </li>
            <% if (currUser.role === 'admin') { %>
              <li><hr class="dropdown-divider border-secondary"></li>
              <li>
                <a class="dropdown-item py-2 d-flex align-items-center gap-2 rounded-2 text-warning" href="/movies/new">
                  <i class="fa-solid fa-plus-circle"></i> Add New Movie
                </a>
              </li>
            <% } %>
            <li><hr class="dropdown-divider border-secondary"></li>
            <li>
              <a class="dropdown-item py-2 d-flex align-items-center gap-2 rounded-2 text-danger" href="/logout">
                <i class="fa-solid fa-right-from-bracket"></i> Sign Out
              </a>
            </li>
          </ul>
        </div>
      <% } %>
    </div>
  </div>
</header>

<!-- Secondary Navigation Links -->
<nav class="bms-subnav d-none d-sm-block">
  <div class="container d-flex justify-content-between align-items-center">
    <ul class="bms-subnav-links">
      <li>
        <a href="/movies" class="bms-subnav-link <%= currentPath.startsWith('/movies') || currentPath === '/' ? 'active' : '' %>">
          Movies
        </a>
      </li>
      <li>
        <a href="/theatres" class="bms-subnav-link <%= currentPath.startsWith('/theatres') ? 'active' : '' %>">
          Cinemas
        </a>
      </li>
      <li>
        <a href="/watchlist" class="bms-subnav-link <%= currentPath.startsWith('/watchlist') ? 'active' : '' %>">
          Watchlist
        </a>
      </li>
      <li>
        <a href="/bookings/history" class="bms-subnav-link <%= currentPath.startsWith('/bookings') ? 'active' : '' %>">
          My Tickets
        </a>
      </li>
    </ul>

    <div class="text-muted small d-none d-lg-block">
      <span class="text-danger fw-bold"><i class="fa-solid fa-bolt me-1"></i>Instant Booking:</span> Verified tickets & 100% money back guarantee
    </div>
  </div>
</nav>