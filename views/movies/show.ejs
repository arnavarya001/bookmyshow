<% layout("layouts/boilerplate") %>

<!-- Movie Backdrop Hero Banner -->
<div class="position-relative rounded-4 overflow-hidden mb-5 shadow-lg" style="background: #11141C; min-height: 440px;">
  <div class="position-absolute w-100 h-100" style="opacity: 0.3; filter: blur(30px) brightness(0.7); background-image: url('<%= movie.backdrop.url %>'); background-size: cover; background-position: center;"></div>
  
  <div class="position-relative z-1 p-4 p-md-5 d-flex flex-column flex-md-row gap-4 align-items-center align-items-md-start">
    <!-- Movie Poster -->
    <div class="flex-shrink-0 text-center" style="width: 250px;">
      <div class="rounded-4 overflow-hidden shadow-2-strong border border-secondary" style="height: 370px;">
        <img src="<%= movie.poster.url %>" alt="<%= movie.title %>" class="w-100 h-100 object-fit-cover">
      </div>
      <div class="mt-3">
        <button class="btn btn-outline-light btn-sm w-100 rounded-pill py-2" data-bs-toggle="modal" data-bs-target="#trailerModal">
          <i class="fa-solid fa-play text-danger me-2"></i>Watch Trailer
        </button>
      </div>
    </div>

    <!-- Movie Details & Metadata -->
    <div class="flex-grow-1 text-white">
      <div class="d-flex align-items-center gap-3 mb-2 flex-wrap">
        <span class="badge bg-danger px-3 py-1 text-uppercase fw-bold"><%= movie.certificate %></span>
        <span class="text-muted"><%= movie.language.join(", ") %></span>
        <span>•</span>
        <span class="text-muted"><%= Math.floor(movie.duration / 60) %>h <%= movie.duration % 60 %>m</span>
        <span>•</span>
        <span class="text-muted"><%= new Date(movie.releaseDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
      </div>

      <h1 class="display-4 fw-black text-white mb-3" style="font-weight: 800;"><%= movie.title %></h1>

      <!-- Rating Pill Card -->
      <div class="d-inline-flex align-items-center gap-4 bg-dark bg-opacity-75 border border-secondary rounded-4 px-4 py-3 mb-4">
        <div class="d-flex align-items-center gap-2">
          <i class="fa-solid fa-star text-danger fs-3"></i>
          <div>
            <div class="h4 mb-0 fw-bold"><%= movie.rating %>/10</div>
            <small class="text-muted"><%= movie.votesCount.toLocaleString("en-IN") %> votes</small>
          </div>
        </div>
        <div class="vr bg-secondary"></div>
        <div>
          <button class="btn btn-bms-outline btn-sm" data-bs-toggle="modal" data-bs-target="#rateModal">
            <i class="fa-regular fa-star me-1"></i>Rate Now
          </button>
        </div>
      </div>

      <!-- Formats -->
      <div class="mb-4">
        <span class="text-muted small fw-bold text-uppercase d-block mb-2">Available Formats:</span>
        <div class="d-flex gap-2">
          <% movie.format.forEach(f => { %>
            <span class="badge bg-secondary bg-opacity-50 border border-secondary px-3 py-2 fs-6"><%= f %></span>
          <% }); %>
        </div>
      </div>

      <!-- CTA Book Tickets Button -->
      <div class="d-flex align-items-center gap-3 flex-wrap">
        <a href="/shows/movie/<%= movie._id %>?city=<%= selectedCity %>" class="btn btn-bms btn-lg px-5 py-3 fs-5 shadow-lg">
          <i class="fa-solid fa-ticket me-2"></i>Book Tickets
        </a>

        <!-- Watchlist Button -->
        <button class="btn btn-bms-dark btn-lg px-4 py-3 movie-watchlist-btn <%= isInWatchlist ? 'active' : '' %>" 
                data-movie-id="<%= movie._id %>">
          <i class="<%= isInWatchlist ? 'fa-solid text-danger' : 'fa-regular' %> fa-heart me-2"></i>Watchlist
        </button>

        <% if (currUser && currUser.role === 'admin') { %>
          <a href="/movies/<%= movie._id %>/edit" class="btn btn-outline-warning btn-lg px-3 py-3">
            <i class="fa-solid fa-pen-to-square"></i>
          </a>
          <form action="/movies/<%= movie._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this movie?');">
            <button class="btn btn-outline-danger btn-lg px-3 py-3">
              <i class="fa-solid fa-trash"></i>
            </button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Trailer Modal -->
<div class="modal fade" id="trailerModal" tabindex="-1" aria-labelledby="trailerModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content bg-black border border-secondary rounded-4 overflow-hidden">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title text-white fw-bold"><%= movie.title %> — Official Trailer</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-0 pt-3">
        <div class="ratio ratio-16x9">
          <iframe src="<%= movie.trailerUrl %>" title="<%= movie.title %> Trailer" allowfullscreen></iframe>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Rate Movie Modal -->
<div class="modal fade" id="rateModal" tabindex="-1" aria-labelledby="rateModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="background: #181C26; border: 1px solid rgba(255,255,255,0.1); border-radius: 16px;">
      <form action="/movies/<%= movie._id %>/reviews" method="POST">
        <div class="modal-header border-bottom border-secondary">
          <h5 class="modal-title text-white fw-bold">Rate & Review "<%= movie.title %>"</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <% if (!currUser) { %>
            <p class="text-white-50">Please <a href="/login" class="text-danger">sign in</a> to submit a review.</p>
          <% } else { %>
            <div class="mb-3">
              <label class="form-label text-white fw-bold">Your Rating (1 to 10)</label>
              <select name="review[rating]" class="form-select form-control-bms" required>
                <option value="10">⭐⭐⭐⭐⭐ (10/10 - Masterpiece!)</option>
                <option value="9">⭐⭐⭐⭐⭐ (9/10 - Exceptional)</option>
                <option value="8" selected>⭐⭐⭐⭐ (8/10 - Very Good)</option>
                <option value="7">⭐⭐⭐⭐ (7/10 - Good Watch)</option>
                <option value="6">⭐⭐⭐ (6/10 - Decent)</option>
                <option value="5">⭐⭐⭐ (5/10 - Average)</option>
                <option value="4">⭐⭐ (4/10 - Below Average)</option>
                <option value="3">⭐⭐ (3/10 - Poor)</option>
                <option value="2">⭐ (2/10 - Very Bad)</option>
                <option value="1">⭐ (1/10 - Terrible)</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label text-white fw-bold">Your Review Comments</label>
              <textarea name="review[comment]" rows="4" class="form-control form-control-bms" placeholder="Share what you loved about the movie, performances, visuals, and music..." required></textarea>
            </div>
          <% } %>
        </div>
        <div class="modal-footer border-top border-secondary">
          <button type="button" class="btn btn-bms-dark" data-bs-dismiss="modal">Cancel</button>
          <% if (currUser) { %>
            <button type="submit" class="btn btn-bms">Submit Review</button>
          <% } %>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="row g-5">
  <!-- Left Column: Story & Cast -->
  <div class="col-lg-8">
    <!-- About the Movie -->
    <section class="mb-5">
      <h3 class="fw-bold text-white mb-3">About the Movie</h3>
      <p class="text-light opacity-90 fs-5 lh-base"><%= movie.synopsis %></p>
    </section>

    <!-- Cast & Crew -->
    <% if (movie.cast && movie.cast.length > 0) { %>
      <section class="mb-5">
        <h3 class="fw-bold text-white mb-4">Cast</h3>
        <div class="row row-cols-2 row-cols-sm-4 g-3">
          <% movie.cast.forEach(actor => { %>
            <div class="col text-center">
              <div class="p-3 rounded-4" style="background: #151821; border: 1px solid rgba(255,255,255,0.06);">
                <img src="<%= actor.photo %>" alt="<%= actor.name %>" class="rounded-circle mb-2 object-fit-cover shadow" style="width: 80px; height: 80px;">
                <h6 class="text-white fw-bold mb-1 small"><%= actor.name %></h6>
                <small class="text-muted d-block" style="font-size: 0.75rem;"><%= actor.role %></small>
              </div>
            </div>
          <% }); %>
        </div>
      </section>
    <% } %>

    <!-- Crew Section -->
    <section class="mb-5">
      <h3 class="fw-bold text-white mb-3">Crew</h3>
      <div class="d-inline-flex align-items-center gap-3 p-3 rounded-4" style="background: #151821; border: 1px solid rgba(255,255,255,0.06);">
        <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; font-size: 1.5rem;">
          🎬
        </div>
        <div>
          <h6 class="text-white fw-bold mb-0"><%= movie.director %></h6>
          <small class="text-muted">Director</small>
        </div>
      </div>
    </section>

    <!-- Reviews & Ratings Section -->
    <section class="mb-5">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <h3 class="fw-bold text-white mb-0">Audience Reviews (<%= movie.reviews ? movie.reviews.length : 0 %>)</h3>
        <button class="btn btn-bms-outline btn-sm" data-bs-toggle="modal" data-bs-target="#rateModal">
          <i class="fa-solid fa-pen-nib me-1"></i>Write a Review
        </button>
      </div>

      <% if (movie.reviews && movie.reviews.length > 0) { %>
        <div class="d-flex flex-column gap-3">
          <% movie.reviews.forEach(review => { %>
            <div class="p-4 rounded-4" style="background: #151821; border: 1px solid rgba(255,255,255,0.06);">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="d-flex align-items-center gap-3">
                  <img src="<%= review.author?.avatar || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=80&q=80' %>" 
                       class="rounded-circle object-fit-cover" style="width: 42px; height: 42px;" alt="User">
                  <div>
                    <h6 class="text-white fw-bold mb-0"><%= review.author ? review.author.username : 'Movie Buff' %></h6>
                    <small class="text-muted"><%= new Date(review.createdAt).toLocaleDateString() %></small>
                  </div>
                </div>
                <div class="d-flex align-items-center gap-3">
                  <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-bold">
                    <i class="fa-solid fa-star me-1"></i><%= review.rating %>/10
                  </span>
                  <% if (currUser && (currUser.role === 'admin' || (review.author && review.author._id.equals(currUser._id)))) { %>
                    <form action="/movies/<%= movie._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST" class="d-inline">
                      <button class="btn btn-link text-danger p-0" title="Delete Review">
                        <i class="fa-solid fa-trash-can"></i>
                      </button>
                    </form>
                  <% } %>
                </div>
              </div>
              <p class="text-light mb-0 fs-6 lh-base"><%= review.comment %></p>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="p-4 rounded-4 text-center text-muted" style="background: #151821; border: 1px dashed rgba(255,255,255,0.1);">
          <i class="fa-regular fa-comment-dots fs-3 mb-2 d-block"></i>
          No reviews yet. Be the first to review "<%= movie.title %>"!
        </div>
      <% } %>
    </section>
  </div>

  <!-- Right Sidebar: Showing In Theatres -->
  <div class="col-lg-4">
    <div class="sticky-top" style="top: 100px;">
      <div class="card bg-dark border-secondary rounded-4 p-4 mb-4">
        <h5 class="text-white fw-bold mb-3"><i class="fa-solid fa-location-dot text-danger me-2"></i>Cinemas in <%= selectedCity %></h5>
        <% if (theatres && theatres.length > 0) { %>
          <div class="d-flex flex-column gap-3 mb-4">
            <% theatres.slice(0, 3).forEach(t => { %>
              <div class="p-3 rounded-3" style="background: #181C26; border: 1px solid rgba(255,255,255,0.06);">
                <h6 class="text-white fw-bold mb-1"><%= t.name %></h6>
                <small class="text-muted d-block mb-2"><%= t.address %></small>
                <div class="d-flex gap-1">
                  <% t.amenities.slice(0, 2).forEach(a => { %>
                    <span class="badge bg-secondary bg-opacity-25 text-white-50" style="font-size: 0.7rem;"><%= a %></span>
                  <% }); %>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <p class="text-muted small mb-4">Showtimes are updated dynamically for your selected city.</p>
        <% } %>

        <a href="/shows/movie/<%= movie._id %>?city=<%= selectedCity %>" class="btn btn-bms w-100 py-3 fw-bold">
          <i class="fa-solid fa-calendar-check me-2"></i>View All Showtimes (<%= upcomingShowsCount %>)
        </a>
      </div>
    </div>
  </div>
</div>
