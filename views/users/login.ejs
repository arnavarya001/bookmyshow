<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center my-5">
  <div class="col-md-5 col-lg-4">
    <div class="bms-auth-card">
      <div class="text-center mb-4">
        <div class="bms-brand-icon mx-auto mb-3" style="width: 48px; height: 48px;">
          <i class="fa-solid fa-user fs-5"></i>
        </div>
        <h3 class="fw-bold text-white mb-1">Welcome Back</h3>
        <p class="text-muted small">Sign in to book tickets and manage reservations</p>
      </div>

      <form action="/login" method="POST">
        <div class="mb-3">
          <label class="form-label text-white fw-semibold small">Username</label>
          <input type="text" name="username" class="form-control form-control-bms" placeholder="Your username" required autofocus>
        </div>

        <div class="mb-4">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <label class="form-label text-white fw-semibold small mb-0">Password</label>
          </div>
          <input type="password" name="password" class="form-control form-control-bms" placeholder="Enter your password" required>
        </div>

        <button type="submit" class="btn btn-bms w-100 py-2 fw-bold shadow">
          Sign In
        </button>
      </form>

      <div class="text-center mt-4 pt-3 border-top border-secondary">
        <span class="text-muted small">Don't have an account? </span>
        <a href="/signup" class="text-danger fw-bold small">Create Account</a>
      </div>
    </div>
  </div>
</div>
