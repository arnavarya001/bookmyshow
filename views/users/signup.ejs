<% layout("layouts/boilerplate") %>

<div class="row justify-content-center my-5">
  <div class="col-md-6 col-lg-5">
    <div class="bms-auth-card">
      <div class="text-center mb-4">
        <div class="bms-brand-icon mx-auto mb-3" style="width: 48px; height: 48px;">
          <i class="fa-solid fa-ticket fs-5"></i>
        </div>
        <h3 class="fw-bold text-white mb-1">Join BookMyShow</h3>
        <p class="text-muted small">Instant movie tickets, exclusive discounts & easy cancellations</p>
      </div>

      <form action="/signup" method="POST">
        <div class="row g-3">
          <div class="col-12">
            <label class="form-label text-white fw-semibold small">Username *</label>
            <input type="text" name="username" class="form-control form-control-bms" placeholder="Choose a username" required autofocus>
          </div>

          <div class="col-12">
            <label class="form-label text-white fw-semibold small">Email Address *</label>
            <input type="email" name="email" class="form-control form-control-bms" placeholder="you@example.com" required>
          </div>

          <div class="col-12">
            <label class="form-label text-white fw-semibold small">Mobile Number</label>
            <input type="tel" name="phone" class="form-control form-control-bms" placeholder="+91 98765 43210">
          </div>

          <div class="col-12">
            <label class="form-label text-white fw-semibold small">Password *</label>
            <input type="password" name="password" class="form-control form-control-bms" placeholder="Create a secure password" required>
          </div>

          <div class="col-12">
            <label class="form-label text-white fw-semibold small">Account Role</label>
            <select name="role" class="form-select form-control-bms">
              <option value="user" selected>Movie Buff (Regular User)</option>
              <option value="admin">Cinema Manager / Admin</option>
            </select>
          </div>

          <div class="col-12 mt-4">
            <button type="submit" class="btn btn-bms w-100 py-2 fw-bold shadow">
              Create Account
            </button>
          </div>
        </div>
      </form>

      <div class="text-center mt-4 pt-3 border-top border-secondary">
        <span class="text-muted small">Already have an account? </span>
        <a href="/login" class="text-danger fw-bold small">Sign In</a>
      </div>
    </div>
  </div>
</div>
